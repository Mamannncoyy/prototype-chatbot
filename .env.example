# Telegram: buat bot dengan @BotFather, lalu isi tokennya.
TELEGRAM_BOT_TOKEN=
# Rahasia webhook acak; gunakan string panjang yang sulit ditebak.
TELEGRAM_WEBHOOK_SECRET=
# Isi ID Telegram yang diizinkan, pisahkan dengan koma. Jangan biarkan kosong saat deploy.
ALLOWED_TELEGRAM_IDS=

# Supabase URL boleh diketahui publik; key dan kredensial login tetap rahasia.
SUPABASE_URL=https://jfvaomhyqcwnxlyweymf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Buat akun Auth khusus bot. Profilnya harus diberi role owner/admin agar RPC dashboard dapat membaca seluruh ringkasan.
SUPABASE_BOT_EMAIL=
SUPABASE_BOT_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
